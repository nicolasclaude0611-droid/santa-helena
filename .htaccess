# Santa Helena del Valle IPS · configuración del servidor (Hostinger)
# Va en la carpeta public_html, junto a index.html.

# ---------- Básico ----------
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------- Siempre con https y sin www ----------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ---------- Direcciones del sitio viejo (WordPress) ----------
# Citas (incluye el enlace del Instagram)
RewriteRule ^(solicitud-de-citas|solicitud-de-citasbk|citasdondoctor)/?$ https://%{HTTP_HOST}/#agendar [R=301,L,NE]
# Servicios
RewriteRule ^(medicina-general|enfermeria|ginecologia|pediatria|nutricion|psicologia|odontologia-especializada|laboratorio-clinico|radiologia-e-imagenes|citologia|citologia-capafina|control-prenatal|control-de-hipertension|crecimiento-de-desarrollo|salud-ocupacional|services|departments)/?$ https://%{HTTP_HOST}/#servicios [R=301,L,NE]
# Quiénes somos
RewriteRule ^(acercadenosotros|valores-corporativos|estructura-organizacional)/?$ https://%{HTTP_HOST}/#nosotros [R=301,L,NE]
# Contacto y sedes
RewriteRule ^contactos/?$ https://%{HTTP_HOST}/#sedes [R=301,L,NE]
# Otras páginas viejas, noticias, categorías y archivos de WordPress: a la portada
RewriteRule ^(aldia|actas-de-reunion|cumplimiento-de-la-circular|deberes-de-los-pacientes|derechos-de-los-pacientes|politica-de-participacion-social-2020|trabaja-con-nosotros|fomagmenu|encuesta-fomag|ver-encuesta|registros-covid|planificadortactico|srincon|formato-de-solicitud-de-materiales-publicitarios|rutas-acceder-tecnologias-no-incluida-plan-beneficio-salud-no-pos-no-pbs|la-importancia-vacunar-bebe|que-son-las-vacunas|a-small-gallery|bienvenidos|[0-9]+-2)/?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(category|tag|type|portfolio-item|portfolio_entries|feed|comments|wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup)\.php$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(.+)/feed/?$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me mailto:; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# ---------- Caché ----------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/webm "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType audio/mpeg "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/xml text/xml text/plain image/svg+xml
</IfModule>

AddType video/webm .webm
AddType image/webp .webp
