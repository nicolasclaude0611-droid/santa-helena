# Santa Helena del Valle IPS · configuración del servidor (Hostinger)
# Va en public_html, junto a index.html.
#
# IMPORTANTE: en public_html conviven otras carpetas con sistemas de la IPS (mesadeayuda, citas, control,
# nube, 2018, Backup2018...). Este archivo está hecho para NO afectarlas:
#   - Solo forzar https y quitar www aplica a todo el dominio.
#   - Las cabeceras de seguridad y la caché se ponen solo en los archivos de la página nueva.
#   - Las redirecciones del WordPress viejo y la página 404 solo actúan si la dirección no existe
#     como archivo o carpeta, y nunca dentro de una carpeta que exista.
#   - No se cambia DirectoryIndex, Options ni ErrorDocument (se heredarían a las subcarpetas).

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------- 1. Siempre con https y sin www (todo el dominio) ----------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ---------- 2. Marcar los archivos de la página nueva (para cabeceras y caché) ----------
RewriteRule ^(|index\.html|politica-de-datos\.html|terminos\.html|404\.html)$ - [E=SHV_HTML:1]
RewriteRule ^(styles\.css|script\.js|legal\.css|robots\.txt|sitemap\.xml|(img|fotos|media|helenita)/.+)$ - [E=SHV_ASSET:1]

# ---------- 3. La portada es la página nueva (aunque quede un index.php viejo) ----------
RewriteRule ^$ index.html [L]

# ---------- 4. Lo que existe (archivos y carpetas, como /mesadeayuda/) se sirve tal cual ----------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------- 5. Direcciones del sitio viejo (WordPress) que ya no existen ----------
# Citas (incluye el enlace del Instagram)
RewriteRule ^(solicitud-de-citas|solicitud-de-citasbk|citasdondoctor)/?$ https://%{HTTP_HOST}/#agendar [R=301,L,NE]
# Servicios
RewriteRule ^(medicina-general|enfermeria|ginecologia|pediatria|nutricion|psicologia|odontologia-especializada|laboratorio-clinico|radiologia-e-imagenes|citologia|citologia-capafina|control-prenatal|control-de-hipertension|crecimiento-de-desarrollo|salud-ocupacional|services|departments)/?$ https://%{HTTP_HOST}/#servicios [R=301,L,NE]
# Quiénes somos
RewriteRule ^(acercadenosotros|valores-corporativos|estructura-organizacional)/?$ https://%{HTTP_HOST}/#nosotros [R=301,L,NE]
# Contacto y sedes
RewriteRule ^contactos/?$ https://%{HTTP_HOST}/#sedes [R=301,L,NE]
# Otras páginas viejas, noticias, categorías y rutas de WordPress: a la portada
RewriteRule ^(aldia|actas-de-reunion|cumplimiento-de-la-circular|deberes-de-los-pacientes|derechos-de-los-pacientes|politica-de-participacion-social-2020|trabaja-con-nosotros|fomagmenu|encuesta-fomag|ver-encuesta|registros-covid|planificadortactico|srincon|formato-de-solicitud-de-materiales-publicitarios|rutas-acceder-tecnologias-no-incluida-plan-beneficio-salud-no-pos-no-pbs|la-importancia-vacunar-bebe|que-son-las-vacunas|a-small-gallery|bienvenidos|[0-9]+-2)/?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^(category|tag|type|portfolio-item|portfolio_entries|feed|comments)(/.*)?$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^bienvenidos/feed/?$ https://%{HTTP_HOST}/ [R=301,L]

# ---------- 6. Página 404 de la página nueva ----------
# Solo para direcciones sueltas de la raíz; nunca dentro de una carpeta que exista ni de los sistemas de la IPS.
RewriteCond $1 !^(mesadeayuda|citas|control|nube|2018|Backup2018|wp-admin|wp-content|wp-includes|cgi-bin)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1 !-d
RewriteRule ^([^/]+) 404.html [L]
</IfModule>

# ---------- Cabeceras de seguridad: solo en la página nueva ----------
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff" env=SHV_HTML
Header always set Referrer-Policy "strict-origin-when-cross-origin" env=SHV_HTML
Header always set X-Frame-Options "SAMEORIGIN" env=SHV_HTML
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" env=SHV_HTML
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me mailto:; frame-ancestors 'self'; upgrade-insecure-requests" env=SHV_HTML
Header always set Cache-Control "no-cache" env=SHV_HTML
Header always set X-Content-Type-Options "nosniff" env=SHV_ASSET
Header always set Cache-Control "public, max-age=2592000" env=SHV_ASSET
</IfModule>

AddType video/webm .webm
AddType image/webp .webp
